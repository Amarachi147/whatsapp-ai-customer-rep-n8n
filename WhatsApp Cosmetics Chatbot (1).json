        "toolDescription": "Sends a product photo to the customer on WhatsApp. Use this whenever a customer asks to see a product or asks what's available. Input should include the direct image URL from the knowledge base for the matching product, and the customer's WhatsApp number.",
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/1172506355940744/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $fromAI('recipient_number', 'the customer WhatsApp number to send the image to') }}\",\n  \"type\": \"image\",\n  \"image\": {\n    \"link\": \"{{ $fromAI('image_url', 'the direct image URL of the product') }}\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
