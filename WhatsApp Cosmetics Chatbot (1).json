      "parameters": {
        "jsCode": "const message = $json.messages?.[0];\nif (!message) {\n  throw new Error('No message payload found in incoming webhook data');\n}\nreturn [{\n  json: {\n    from: message.from,\n    text: message.text?.body || '',\n    messageId: message.id\n  }\n}];"
